APP_HTTP_PORT=18080
# APP_BIND_ADDRESS=127.0.0.1
# ADMIN_HTTP_PORT=18083
# ADMIN_BIND_ADDRESS=127.0.0.1
MYSQL_HOST_PORT=3307
MYSQL_DATABASE=fuelau
MYSQL_USER=fuelau
MYSQL_ROOT_PASSWORD=replace_with_database_root_password
MYSQL_PASSWORD=replace_with_database_password
MYSQL_APP_USER=fuelau_app
MYSQL_APP_PASSWORD=replace_with_app_database_password
MYSQL_SYNC_USER=fuelau_sync
MYSQL_SYNC_PASSWORD=replace_with_sync_database_password
NOMINATIM_PASSWORD=replace_with_nominatim_password
# NOMINATIM_THREADS=4
# NOMINATIM_GUNICORN_WORKERS=4
FUELAU_HOST_PROJECT_ROOT=/opt/FuelAU
UID=999
GID=999
TZ=Australia/Brisbane
# POSIX timezone used by the lightweight map-scheduler image (Brisbane, UTC+10).
MAP_SCHEDULER_TZ=AEST-10
# CONTAINER_MANAGEMENT_TOKEN=replace_with_container_management_token
