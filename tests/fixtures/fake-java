#!/bin/sh
set -eu

output=""
for argument in "$@"; do
    case "$argument" in
        --output=*)
            output="${argument#--output=}"
            ;;
    esac
done

if [ "$output" = "" ]; then
    printf '%s\n' "Missing --output argument" >&2
    exit 2
fi

case "$output" in
    *.mbtiles) ;;
    *)
        printf '%s\n' "Planetiler output must end in .mbtiles: $output" >&2
        exit 3
        ;;
esac

if [ "${FAKE_PLANETILER_OUTPUT_LOG:-}" != "" ]; then
    printf '%s\n' "$output" > "$FAKE_PLANETILER_OUTPUT_LOG"
fi

printf '%s\n' "generated-map" > "$output"
touch "$output-wal" "$output-shm"

if [ "${FAKE_PLANETILER_FAIL:-0}" = "1" ]; then
    exit 42
fi
