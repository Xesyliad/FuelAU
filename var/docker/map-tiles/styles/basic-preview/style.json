{
  "version": 8,
  "name": "FuelAU Basic Preview",
  "glyphs": "{fontstack}/{range}.pbf",
  "sources": {
    "australia": {
      "type": "vector",
      "url": "mbtiles://{australia}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#dbeafe"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "australia",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9fd0ee"
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "australia",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#7c8fa1",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          0.5,
          4,
          1.2,
          7,
          2.2
        ]
      }
    },
    {
      "id": "road-ferry",
      "type": "line",
      "source": "australia",
      "source-layer": "transportation",
      "filter": ["==", "class", "ferry"],
      "paint": {
        "line-color": "#6b7280",
        "line-dasharray": [2, 2],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.6,
          10,
          1.4,
          14,
          2.4
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "australia",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "busway"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.4,
          11,
          0.9,
          14,
          2,
          16,
          4
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "australia",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#fff7ed",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.5,
          8,
          1.2,
          12,
          3,
          16,
          8
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "australia",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "trunk"],
      "paint": {
        "line-color": "#f8fafc",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.7,
          8,
          1.7,
          12,
          4,
          16,
          10
        ]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "australia",
      "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "paint": {
        "line-color": "#fff",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          1,
          8,
          2.2,
          12,
          5,
          16,
          12
        ]
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "australia",
      "source-layer": "place",
      "minzoom": 0,
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name_en"],
          ["get", "name_int"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          12,
          4,
          16,
          7,
          20
        ],
        "text-anchor": "center",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#1f2937",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "australia",
      "source-layer": "transportation_name",
      "minzoom": 10,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "ref"],
          ["get", "name"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          10,
          14,
          12
        ]
      },
      "paint": {
        "text-color": "#374151",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}
